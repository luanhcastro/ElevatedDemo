# Public Supabase browser configuration. These values are not used by Issue #2 yet.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Never place a Supabase secret key, service-role key, database password, or access
# token in a NEXT_PUBLIC_* variable. Keep local secrets in .env.local, which is ignored.
