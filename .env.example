# Public Supabase browser configuration used by the application.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key required by trusted user-provisioning operations. Never expose
# this value through a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=your-secret-key

# Never place a Supabase secret key, service-role key, database password, or access
# token in a NEXT_PUBLIC_* variable. Keep local secrets in .env.local, which is ignored.
